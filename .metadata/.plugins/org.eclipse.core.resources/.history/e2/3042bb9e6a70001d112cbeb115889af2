// Bitwise operations ----------------------------------------------------------
#define BIT(x)					(0x00000001U << (x)) // Return the number representing the x_th bit
#define SETBITS(x, y)			((x) |= (y)) // Set all bits in x masked by y
#define CLEARBITS(x, y)			((x) &= ~(y)) // Clear all bits in x masked by y
#define TOGGLEBITS(x, y)			((x) ^= (y)) // Toggle all bits in x masked by y
#define CHECKBIT(x, y)			((x) & (1<<(y))) //
//#define COPYBITS(x, y, m)	((x) = ((x) & ~(m-1)) | ((y) & (m))) // Copy n bits from position p of x to y
#define COPYBITS(x, y, n, p)	((x) = ((x) & ~((1 << n) << p)) | ((y) & ((1 << n) << p))) // Copy n bits from position p of y to x

