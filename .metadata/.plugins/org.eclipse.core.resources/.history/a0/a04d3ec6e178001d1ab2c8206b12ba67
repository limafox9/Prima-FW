void ProtocolInit(protocolSetup_s* setup) {

	ptr_activeUART = setup->ptr_uart;
	activeTxTimeout = setup->txTimeout;
	activeProtocolHead = setup->packetHead;
	activeProtocolTail = setup->packetTail;

}

