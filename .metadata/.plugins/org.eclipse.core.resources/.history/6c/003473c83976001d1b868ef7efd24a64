void sendSerialData(struct serialKeys_s* keys){
//	void sendSerialData(struct serialKeys_s* keys, UART_HandleTypeDef * huart){

	char buffer[sizeof(*keys)]; // Create a char buffer of right size

	//char message[] = "CIAO\r\n";
	strncpy(keys->markHead, SERIAL_KEYS_PACKET_HEAD, sizeof(SERIAL_KEYS_PACKET_HEAD));
	strncpy(keys->markTail, SERIAL_KEYS_PACKET_TAIL, sizeof(SERIAL_KEYS_PACKET_TAIL));

	keys->CRC16 = 0;
	//checksum = crc16(&keys, sizeof(*keys));
	keys->CRC16 = crc16(keys, sizeof(*keys));

  // UART can only send unsigned int
  // Thus we need to convert our struct data


  // Copy the data to buffer

	memcpy(buffer, keys, sizeof(*keys)); // Copy and convert the data

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	HAL_UART_Transmit(&UART, (uint8_t *)buffer, sizeof(buffer), 50);
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);
}

void serialSendPacket(uint8_t* payload[]) {

	uint16_t crc;

	crc = crc16(payload, sizeof(*payload));

	uint8_t* txBuffer = malloc(8 * (sizeof(SERIAL_KEYS_PACKET_HEAD) + sizeof(*payload) + sizeof(crc) + sizeof(SERIAL_KEYS_PACKET_TAIL)));
	memcpy(txBuffer, (char[]*)SERIAL_KEYS_PACKET_HEAD, sizeof(SERIAL_KEYS_PACKET_HEAD)); // copy 4 floats from x to total[0]...total[3]
	memcpy(txBuffer, *SERIAL_KEYS_PACKET_HEAD, sizeof(SERIAL_KEYS_PACKET_HEAD)); // copy 4 floats from x to total[0]...total[3]
}

void serialTransmit(uint8_t* buffer[]) {

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	HAL_UART_Transmit(&UART, buffer, sizeof(*buffer), SERIAL_TX_TIMEOUT);
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}
