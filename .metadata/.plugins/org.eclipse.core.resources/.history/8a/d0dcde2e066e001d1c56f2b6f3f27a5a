#include "main.h"
#include "cmsis_os.h"
#include "globals.h"

void Beep(u8 hits, u16 onDelay, u16 offDelay) {

	u8 i;

	for (i = 0; i < hits; i++) {
		HAL_GPIO_WritePin(BEEP_GPIO_Port, BEEP_Pin, GPIO_PIN_SET);
		osDelay(onDelay);
		HAL_GPIO_WritePin(BEEP_GPIO_Port, BEEP_Pin, GPIO_PIN_RESET);
		osDelay(offDelay);
	}

}
