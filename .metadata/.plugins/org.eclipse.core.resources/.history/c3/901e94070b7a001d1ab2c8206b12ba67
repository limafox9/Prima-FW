#include <string.h>
#include "serial_protocol.h"

UART_HandleTypeDef* p_activeUART;
uint16_t activeTxTimeout = 50;
char* activeProtocolHead = "<~";
char* activeProtocolTail = "~>";

void SerialTransmit(uint8_t* p_txBuffer, uint16_t txBufferSize);


void ProtocolSendKeys(UART_HandleTypeDef* huart, uint8_t keys) {

	p_activeUART = huart;

	uint8_t payload[14];
	memset(payload,0,14);

	uint16_t command = COMMAND_KEYS_PRESSED;
	uint32_t param1, param2, param3;

	param1 = 0xFFFFFFFF;
	param2 = 0xFFFFFFFF;
	param3 = 0xFFFFFFFF;

	memcpy(payload, &command, 2);
	memcpy(payload + 2, &param1, 4);
	memcpy(payload + 4 + 4, &param2, 4);
	memcpy(payload + 4 + 4 + 4, &param3, 4);
//	payload[0] = COMMAND_KEYS_PRESSED >> 8;
//	payload[1] = COMMAND_KEYS_PRESSED & 0xFF;
//	payload[2] = keys;
	ProtocolTransmit(command, payload, 14);

}

void ProtocolTransmit(uint16_t command, uint8_t* p_data, uint16_t dataSize) {

	uint16_t bufferSize;
	uint16_t checksum;

	bufferSize = strlen(activeProtocolHead) + dataSize + sizeof(checksum) + strlen(activeProtocolTail) + 1;
	uint8_t* p_txBuffer[bufferSize];
	memset(p_txBuffer, 0xFF, bufferSize);

	memcpy(p_txBuffer, activeProtocolHead, 2);
	memcpy(p_txBuffer + 2, p_data, dataSize);
	checksum = 0x6565;
	memcpy(p_txBuffer + 2 + dataSize, &checksum, 2);
	memcpy(p_txBuffer + 2 + dataSize + 2, activeProtocolTail, 2);
	memcpy(p_txBuffer + 2 + dataSize + 2 + 2, "\n", 1);


	//char* str_txBufferTerminated[10];
	//sprintf(str_txBufferTerminated, "%s%s%s\n", (const char*)s, (const char*)ptr_payload, (const char*)activeProtocolTail.packetTerminator);

	SerialTransmit(p_txBuffer, bufferSize);

}

void SerialTransmit(uint8_t* p_Buffer, uint16_t txBufferSize) {

	// Chip 485 ENABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	// TRANSMIT
	HAL_UART_Transmit(p_activeUART, p_Buffer, txBufferSize, activeTxTimeout);
	// Chip 485 DISABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}

