#include "keys.h"

extern uint8_t GetKeys() {


	keysPressed = !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin));
	keysPressed += !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin)) << 1;
	keysPressed += !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin)) << 2;

	if (keysPressed & 1) {
		Beep(1, 200, 100);
	}
	if (!(HAL_GPIO_ReadPin(KEY_TEST_GPIO_Port, KEY_TEST_Pin))) {
		Beep(2, 200, 100);
	}
	if (!(HAL_GPIO_ReadPin(KEY_START_GPIO_Port, KEY_START_Pin))) {
		Beep(3, 200, 100);
	}
}
