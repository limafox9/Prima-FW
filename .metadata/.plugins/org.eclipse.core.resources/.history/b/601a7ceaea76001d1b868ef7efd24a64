void serialSendPacket(uint32_t* p_command, uint8_t commandSize, uint32_t* p_payload, uint8_t payloadSize) {

	uint16_t checksum;

	char markHead = SERIAL_PACKET_HEAD;
	size_t headSize = sizeof(markHead);
	//size_t commandSize = sizeof(*command);
	char markTail = SERIAL_PACKET_TAIL;
	size_t tailSize = sizeof(SERIAL_PACKET_TAIL);
	//size_t payloadSize = sizeof(*payload);
	size_t checksumSize = sizeof(checksum);

	uint8_t* txBuffer[headSize + commandSize + payloadSize + checksumSize + tailSize];

	checksum = crc16(p_payload, sizeof(*p_payload));

//	txBuffer = (uint8_t*)malloc()headSize + identifierSize + payloadSize + checksumSize + tailSize);

	memcpy(txBuffer, &markHead, headSize);
	memcpy(txBuffer + headSize, p_command, commandSize);
	memcpy(txBuffer + headSize + commandSize, p_payload, payloadSize);
	memcpy(txBuffer + headSize + commandSize + payloadSize, &checksum, checksumSize);
	memcpy(txBuffer + headSize + commandSize + payloadSize + checksumSize, &markTail, tailSize);

	serialTransmit(txBuffer);

}


void serialTransmit(uint8_t* p_txBuffer) {

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	HAL_UART_Transmit(&UART, p_txBuffer, sizeof(*p_txBuffer), SERIAL_TX_TIMEOUT);
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}
