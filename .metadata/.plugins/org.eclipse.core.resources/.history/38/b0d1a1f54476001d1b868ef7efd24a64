void serialSendPacket(uint8_t* payload[], char* identifier[]) {

	uint16_t crc;
	size_t headSize = sizeof(SERIAL_PACKET_HEAD);
	size_t identifierSize = sizeof(identifier);
	size_t tailSize = sizeof(SERIAL_PACKET_TAIL);
	size_t payloadSize = sizeof(*payload);
	size_t crcSize = sizeof(crc);

	crc = crc16(payload, sizeof(*payload));

	uint8_t* txBuffer = malloc(8 * (headSize + payloadSize + crcSize + tailSize));
	memcpy(txBuffer, SERIAL_PACKET_HEAD, headSize); // copy 4 floats from x to total[0]...total[3]
	memcpy(txBuffer + identifierSize, *identifier, headSize); // copy 4 floats from x to total[0]...total[3]
	memcpy(txBuffer + identifierSize + headSize, *payload, payloadSize); // copy 4 floats from x to total[0]...total[3]
	memcpy(txBuffer + identifierSize + headSize + payloadSize, crc, crcSize); // copy 4 floats from x to total[0]...total[3]
	memcpy(txBuffer + identifierSize + headSize  + payloadSize + crcSize, SERIAL_PACKET_TAIL, tailSize); // copy 4 floats from x to total[0]...total[3]

	serialTransmit(txBuffer);
}

void serialTransmit(uint8_t* buffer[]) {

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	HAL_UART_Transmit(&UART, buffer, sizeof(*buffer), SERIAL_TX_TIMEOUT);
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}
