void serialSendPacket(uint8_t* payload[], char* identifier[]) {

	uint16_t checksum;
	size_t headSize = sizeof(SERIAL_PACKET_HEAD);
	size_t identifierSize = sizeof(identifier);
	size_t tailSize = sizeof(SERIAL_PACKET_TAIL);
	size_t payloadSize = sizeof(*payload);
	size_t checksumSize = sizeof(checksum);

	checksum = crc16(payload, sizeof(*payload));

	uint8_t* txBuffer = malloc(8 * (headSize + identifierSize + payloadSize + checksumSize + tailSize));

	memcpy(txBuffer, SERIAL_PACKET_HEAD, headSize);
	memcpy(txBuffer + headSize, *identifier, identifierSize);
	memcpy(txBuffer + headSize + identifierSize, *payload, payloadSize);
	memcpy(txBuffer + headSize + identifierSize + payloadSize, checksum, checksumSize);
	memcpy(txBuffer + headSize + identifierSize + payloadSize + checksumSize, SERIAL_PACKET_TAIL, tailSize);

	serialTransmit(txBuffer);

}


void serialTransmit(uint8_t* txBuffer[]) {

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	HAL_UART_Transmit(&UART, txBuffer, sizeof(*txBuffer), SERIAL_TX_TIMEOUT);
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}
