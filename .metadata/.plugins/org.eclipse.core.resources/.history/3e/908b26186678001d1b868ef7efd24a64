#include <string.h>
#include "serial_protocol.h"

UART_HandleTypeDef* ptr_activeUART;
uint16_t activeTxTimeout;

void SerialTransmit(char* ptr_txBuffer);

void ProtocolInit(UART_HandleTypeDef* ptr_uart, uint16_t txTimeout) {

	ptr_activeUART = ptr_uart;
	activeTxTimeout = txTimeout;
}


void ProtocolTransmit(char* ptr_txBuffer) {

	int a = strlen(ptr_txBuffer);
	char* e = "\r\n";
//	strcat(ptr_txBuffer, e);
	sprintf("%s\n", ptr_txBuffer);
	a = strlen(ptr_txBuffer);
	// Chip 485 ENABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	// TRANSMIT
	HAL_UART_Transmit(ptr_activeUART, ptr_txBuffer, a, activeTxTimeout);
	// Chip 485 DISABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}

void SerialTransmit(char* ptr_txBuffer) {

	strcat(ptr_txBuffer, "\r\n");
	// Chip 485 ENABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	// TRANSMIT
	HAL_UART_Transmit(ptr_activeUART, ptr_txBuffer, strlen(ptr_txBuffer), activeTxTimeout);
	// Chip 485 DISABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}

