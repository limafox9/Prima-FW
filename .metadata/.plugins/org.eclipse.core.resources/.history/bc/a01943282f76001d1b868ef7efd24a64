void sendSerialData(struct serialKeys_s* keys){
//	void sendSerialData(struct serialKeys_s* keys, UART_HandleTypeDef * huart){

	char buffer[sizeof(*keys)+1]; // Create a char buffer of right size
	uint16_t checksum;

	//char message[] = "CIAO\r\n";
	strcpy(keys->markHead, SERIAL_PACKET_HEAD);
	strcpy(keys->markTail, SERIAL_PACKET_TAIL);

	keys->CRC16 = 0;
	//checksum = crc16(&keys, sizeof(*keys));
	keys->CRC16 = crc16(&keys, sizeof(*keys));

  // UART can only send unsigned int
  // Thus we need to convert our struct data


  // Copy the data to buffer

	memcpy(buffer, keys, sizeof(*keys)); // Copy and convert the data

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	HAL_UART_Transmit(&UART, (uint8_t *)buffer, sizeof(buffer), 50);
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);
}
