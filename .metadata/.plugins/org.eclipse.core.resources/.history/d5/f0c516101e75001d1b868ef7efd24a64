#include "keys.h"

uint8_t GetKeys();
uint8_t GetPressedKeys();

uint8_t GetKeys() {

	uint8_t lastValue = 0;
	uint8_t currentKeys = 0;

	currentKeys = !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin));

	// Keys active low
	while (currentKeys > 0) {
		lastValue = currentKeys;
		currentKeys = !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin));
	}

	return lastValue;

//	if (keysPressed & 2) {
//		Beep(2, 200, 100);
//	}
//	if (keysPressed & 4) {
//		Beep(3, 200, 100);
//	}
}

uint8_t GetPressedKeys() {

	uint8_t currentKeys = 0;

	currentKeys = !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin));
	currentKeys += !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin)) << 1;
	currentKeys += !(HAL_GPIO_ReadPin(KEY_PROG_GPIO_Port, KEY_PROG_Pin)) << 2;

}


