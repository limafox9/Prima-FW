#include "main.h"
#include "PanelLeds.h"

void ClearAll(){

	HAL_GPIO_WritePin(LED_WARNING_CTL_GPIO_Port, LED_WARNING_CTL_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_WARNING_LSH_GPIO_Port, LED_WARNING_LSH_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED_WARNING_TDS_GPIO_Port, LED_WARNING_TDS_Pin, GPIO_PIN_RESET);
}

void PanelLeds::setWarningCTL(int status){

	if (status == LED_ON){
		HAL_GPIO_WritePin(LED_WARNING_CTL_GPIO_Port, LED_WARNING_CTL_Pin, GPIO_PIN_SET);
	} else {
		HAL_GPIO_WritePin(LED_WARNING_CTL_GPIO_Port, LED_WARNING_CTL_Pin, GPIO_PIN_RESET);
	}
}

void PanelLeds::setWarningLSH(int status){

	if (status == LED_ON){
		HAL_GPIO_WritePin(LED_WARNING_LSH_GPIO_Port, LED_WARNING_LSH_Pin, GPIO_PIN_SET);
	} else {
		HAL_GPIO_WritePin(LED_WARNING_LSH_GPIO_Port, LED_WARNING_LSH_Pin, GPIO_PIN_RESET);
	}
}

