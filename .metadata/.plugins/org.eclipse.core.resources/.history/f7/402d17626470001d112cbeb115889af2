// Bitwise operations ----------------------------------------------------------
#define BIT(x)					(0x00000001U << (x))
#define SETBIT(x, y)			((x) |= (y))
#define CLEARBIT(x, y)			((x) &= ~(y))
#define TOGGLEBIT(x, y)			((x) ^= (y))
#define CHECKBIT(x, y)			((x) & (y))
#define COPYBITS(x, y, n, p)	(y & ~(((1 << n) - 1) << p)) | (x & (((1 << n) - 1) << p)) // Copy n bits from position p of x to y

