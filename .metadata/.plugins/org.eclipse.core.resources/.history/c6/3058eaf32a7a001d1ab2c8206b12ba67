#include <string.h>
#include "crc16.h"
#include "serial_protocol.h"

UART_HandleTypeDef* p_activeUART;
const uint16_t activeTxTimeout = 50;
const char activeProtocolHead[] = {'<', '~'};
const char activeProtocolTail[] =  {'~', '>'};
const char activeProtocolEOF = '\n';

const uint8_t pos_head = 0;
const uint8_t  pos_command = 2;
const uint8_t  pos_param1 = 4;
const uint8_t  pos_param2 = 8;
const uint8_t  pos_param3 = 12;
const uint8_t  pos_param4 = 16;
const uint8_t  pos_checksum = 20;
const uint8_t  pos_tail = 22;
const uint8_t  pos_EOF = 24;

uint8_t UART_rxBuffer[30] = {0};


void ProtocolInit(UART_HandleTypeDef* huart) {

	p_activeUART = huart;
	HAL_UART_Receive_DMA(p_activeUART, UART_rxBuffer, 30);

}

void ProtocolTransmit(uint16_t command, uint32_t param1, uint32_t param2, uint32_t param3, uint32_t param4) {

	uint16_t bufferSize;
	uint16_t checksum;

//	p_activeUART = huart;

	bufferSize = pos_EOF + 1;
	uint8_t p_txBuffer[bufferSize];
	memset(p_txBuffer, 0, bufferSize);

	memcpy(p_txBuffer + pos_head, activeProtocolHead, 2);
	memcpy(p_txBuffer + pos_command, &command, 2);
	memcpy(p_txBuffer + pos_param1, &param1, 4);
	memcpy(p_txBuffer + pos_param2, &param2, 4);
	memcpy(p_txBuffer + pos_param3, &param3, 4);
	memcpy(p_txBuffer + pos_param4, &param4, 4);
	memcpy(p_txBuffer + pos_tail, activeProtocolTail, 2);
	memcpy(p_txBuffer + pos_EOF, &activeProtocolEOF, 1);

	checksum = crc16(p_txBuffer, bufferSize - 1);
	memcpy(p_txBuffer + pos_checksum, &checksum, 2);

	//char* str_txBufferTerminated[10];
	//sprintf(str_txBufferTerminated, "%s%s%s\n", (const char*)s, (const char*)ptr_payload, (const char*)activeProtocolTail.packetTerminator);

	SerialTransmit(p_txBuffer, bufferSize);

}

void SerialTransmit(uint8_t* p_Buffer, uint16_t txBufferSize) {

	// Chip 485 ENABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	// TRANSMIT
	HAL_UART_Transmit(p_activeUART, p_Buffer, txBufferSize, activeTxTimeout);
	// Chip 485 DISABLE
	//HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
	HAL_UART_Receive_DMA(p_activeUART, UART_rxBuffer, 5);
	SerialTransmit("CIAO",4);
}
