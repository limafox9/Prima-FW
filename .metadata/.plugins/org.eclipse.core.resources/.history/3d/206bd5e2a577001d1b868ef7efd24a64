#include <stdlib.h>
#include "serial.h"

struct serialPacket_s {
	char markHead[2];
	char command[3];
	uint8_t* p_payload;
	uint16_t crc16;
	char markTail[4];
};


void SerialSendCommand(command_e command, uint8_t* ptr_payload, uint16_t payloadSize);
void SerialTransmit(uint8_t* p_txBuffer, size_t size);
void SwapBytes(void *pv, size_t n);

// ==============================================================

void SendKeys(uint8_t keys){

	SerialSendCommand(COMMAND_KEYS_PRESSED, &keys, sizeof(keys));
}

// ==============================================================

void SerialSendCommand(command_e command, uint8_t* ptr_payload, uint16_t payloadSize) {

	uint16_t checksum;
	uint32_t head = SERIAL_PACKET_HEAD;
	uint32_t tail = SERIAL_PACKET_TAIL;

	size_t bufferSize = sizeof(head) + sizeof(command) + payloadSize + sizeof(checksum) + sizeof(tail);

	uint8_t* txBuffer = malloc(bufferSize);

	checksum = crc16(ptr_payload, payloadSize);

	if (L_ENDIAN) {
		SwapBytes(&head, sizeof(head));
		SwapBytes(&command, sizeof(command));
		SwapBytes(ptr_payload, payloadSize);
		SwapBytes(&checksum, sizeof(checksum));
		SwapBytes(&tail, sizeof(tail));
	}

	memcpy(txBuffer, &head, sizeof(head));
	memcpy(txBuffer + sizeof(head), &command, sizeof(command));
	memcpy(txBuffer + sizeof(head) + sizeof(command), ptr_payload, payloadSize);
	memcpy(txBuffer + sizeof(head) + sizeof(command) + payloadSize, &checksum, sizeof(checksum));
	memcpy(txBuffer + sizeof(head) + sizeof(command) + payloadSize + sizeof(checksum), &tail, sizeof(tail));

	SerialTransmit(txBuffer, bufferSize);

	free(txBuffer);

}

void SerialTransmit(uint8_t* p_txBuffer, size_t size) {

	// Chip 485 ENABLE
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);
	// TRANSMIT
	HAL_UART_Transmit(&UART, p_txBuffer, size, SERIAL_TX_TIMEOUT);
	// Chip 485 DISABLE
	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}


void SwapBytes(void *pv, size_t n) {
    char *p = pv;
    size_t lo, hi;
    for(lo=0, hi=n-1; hi>lo; lo++, hi--)
    {
        char tmp=p[lo];
        p[lo] = p[hi];
        p[hi] = tmp;
    }
}
