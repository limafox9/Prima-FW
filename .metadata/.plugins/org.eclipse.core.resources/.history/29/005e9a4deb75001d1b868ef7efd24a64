#include "serial.h"

void SendKeysSerial(KeyPressedStruct keys) {

	char message[50];

	sprintf(message, "<~%i:%i~>", keys.keys,keys.CRC16);

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 1);

	HAL_UART_Transmit(&usart1,message,sizeof(message),10);// Sending in normal mode

	HAL_GPIO_WritePin(USART1_CTS_GPIO_Port, USART1_CTS_Pin, 0);

}
